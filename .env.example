# Backend: safe by default; bind to 127.0.0.1:8000 only.
PAPER_DB=./data/paper.sqlite3
FRONTEND_ORIGIN=http://localhost:3000
AUTO_PAPER=false
PAPER_INTERVAL_SECONDS=120
# Optional AI advisory: HTTPS OpenAI-compatible chat-completions endpoint.
# Without these three vars AI returns WAIT, never BUY.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Frontend: set inside frontend/.env.local if backend origin differs
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
